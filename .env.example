# CleanGuard — environment variable reference.
#
# This project has two runtimes (a PHP backend and a Vite/React
# frontend), each with its own env file — copy this reference into
# whichever one applies to your setup, or use the ones already provided:
#   frontend/.env.example        -> frontend/.env      (Vite)
#   backend/config.local.example.php -> backend/config.local.php (PHP)
#
# None of the values below are real credentials.

# ---- Backend (PHP) — database connection ----
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ---- Frontend (React/Vite) — backend API base URL ----
VITE_API_URL=https://your-api-domain.com
